# Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Provider Models
GROQ_GEN_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

# Thresholds & Parameters
INTENT_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_SIMILARITY_FLOOR=0.65
TOP_K_PASSAGES=3
TOP_K_ESCALATE=2
PROVIDER_REQUEST_TIMEOUT=10.0
PROVIDER_MAX_RETRIES=1
BACKOFF_BASE=1.0
BACKOFF_CAP=8.0
BATCH_DELAY=1.5
GENERATION_TEMPERATURE=0.0

# Storage Paths
CHROMA_PERSIST_DIR=data/chromadb
DECISION_LOG_PATH=data/decision_log.db

